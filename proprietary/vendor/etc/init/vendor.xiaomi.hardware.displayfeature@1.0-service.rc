# aidl call adaptation
service vendor.displayfeature-hal-1-0 /vendor/bin/hw/vendor.xiaomi.hardware.displayfeature@1.0-service
    class hal
    user system
    group system graphics
    onrestart restart displayfeature

on boot
    chown system system /sys/devices/virtual/graphics/fb0/hist_event
    chown system system /sys/devices/platform/soc/14000000.dispsys_config/disp_param
    chmod 0664 /sys/devices/platform/soc/14000000.dispsys_config/disp_param

on post-fs-data
    chown system system /sys/class/drm/card0-DSI-1/mipi_reg
    chmod 664 /sys/class/drm/card0-DSI-1/mipi_reg
    chown system system /sys/class/drm/card0-DSI-1/doze_brightness
    chmod 0664 /sys/class/drm/card0-DSI-1/doze_brightness
    chown system system /sys/class/mi_display/disp-DSI-0/cabc_mode
    chmod 0664 /sys/class/mi_display/disp-DSI-0/cabc_mode
    chown system system /sys/class/mi_display/disp-DSI-0/panel_info
    chmod 0664 /sys/class/mi_display/disp-DSI-0/panel_info
    chown system system /sys/class/thermal/thermal_message/board_sensor_temp
    chmod 0664 /sys/class/thermal/thermal_message/board_sensor_temp

